---
import PublicLayout from '@/layouts/PublicLayout.astro';
import ProductDetail from '@/app/features/product/ProductDetail';
import { PRODUCTS } from '@/app/mock/catalog';
import { t } from '@/app/i18n';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({ params: { id: product.id } }));
}

const { id } = Astro.params;
const product = PRODUCTS.find((item) => item.id === id);
---

<PublicLayout title={product?.name ?? t('meta.defaultTitle')} description={product?.description}>
  <ProductDetail productId={id!} client:load />
</PublicLayout>
