---
import BaseLayout from './BaseLayout.astro';
import Footer from './Footer.astro';
import Navbar from '@/app/features/landing/components/layout/Navbar';
import SideDrawer from '@/app/features/landing/components/layout/SideDrawer';

interface Props {
  title?: string;
  description?: string;
  hideNavbar?: boolean;
}

const { title, description, hideNavbar = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="flex min-h-dvh w-full flex-col bg-surface">
    {!hideNavbar && <Navbar client:load />}
    <main class="mx-auto w-full max-w-7xl flex-1">
      <slot />
    </main>
    <Footer />
    <SideDrawer client:load />
  </div>
</BaseLayout>
