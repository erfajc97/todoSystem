---
import { t } from '@/app/i18n';

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-5 px-5 py-8 sm:flex-row sm:items-center sm:justify-between lg:px-8">
    <a href="/" class="font-heading text-base font-extrabold tracking-tight text-text">
      {t('brand')}
    </a>
    <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-text-muted">
      <a href="/categorias" class="hover:text-text">{t('nav.categories')}</a>
      <a href="/buscar" class="hover:text-text">{t('nav.search')}</a>
      <a href="/chat" class="hover:text-text">{t('nav.chat')}</a>
      <a href="/reserva/svc-basico" class="hover:text-text">{t('nav.bookings')}</a>
    </nav>
    <p class="text-sm text-text-muted">{t('footer.rights', { year })}</p>
  </div>
</footer>
